[application]
config/name="Medieval Sandbox"
run/main_scene="res://main.tscn"

[autoload]
BattleController="*res://battle_controller.gd"
FinalGameSystems="*res://final_game_systems.gd"
FinalSystemsUI="*res://final_systems_ui.gd"
CampaignSystems="*res://campaign_systems.gd"
CompletionSystems="*res://completion_systems.gd"
ReleaseContent="*res://release_content.gd"
ReleaseExpansion="*res://release_expansion.gd"
ReleasePolish="*res://release_polish.gd"
ReleaseProductionPolish="*res://release_production_polish.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.10, 1)
textures/vram_compression/import_etc2_astc=true

[input]
move_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
